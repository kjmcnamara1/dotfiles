# This file was auto-generated by Stasis on first run
# Feel free to customize it to your needs
# Master config reference: `/etc/stasis/stasis.rune`
# https://saltnpepper97.github.io/stasis-site/configuration

@author "Kevin McNamara"
@description "Lightweight feature packed idle manager for Wayland"

default:
  # enable_loginctl true
  # pre_suspend_command "systemctl --user start hyprlock"
  monitor_media true
  ignore_remote_media true # Ignore remote players such as Spotify, KDE Connect, etc.
  #media_blacklist ["spotify"] 
  respect_idle_inhibitors true

  # Lock detection method: "process" (default) or "logind"
  # Use "logind" if your locker uses loginctl (e.g., quickshell)
  # lock_detection_type "logind"

  #debounce-seconds 4
  #notify_on_unpause true
  #notify-before-command true
  #notify-seconds-before 10

  inhibit_apps [
    # "vlc"
    # "mpv"
    "gamescope"
    r"steam_app_.*"
    "pyrogenesis" # 0 A.D. game
  ]

  lid_close_action "lock_screen"
  lid_open_action "wake"

  lock_screen:
    timeout 300 # 5 minute(s)
    # command "loginctl lock-session"
    command "hyprlock"
  end

  dpms:
    timeout 300 # 5 minute(s) after lock
    command "niri msg action power-off-monitors"
    resume_command "niri msg action power-on-monitors"
  end

  suspend:
    timeout 1200 # 20 minute(s) after dpms
    command "systemctl suspend"
  end

end
