{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "session": {
    "thinking": "hide",
    "permissions": "autoaccept",
    "scrollbar": true,
    "verbosity": "low",
    "image_preview": false
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd"
  },
  "plugins": [
    "@leohenon/opencode-vim-plugin@beta"
  ]
}
