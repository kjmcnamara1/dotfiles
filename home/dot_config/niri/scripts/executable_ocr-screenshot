#!/usr/bin/env bash
# Select a screen region, OCR it with tesseract, and copy the text to the
# clipboard. Uses the DMS region selector (same as the Print binds) and
# pipes the image straight through without saving a file.

app="OCR"

text=$(dms screenshot region --stdout --no-file --no-clipboard --no-notify \
  | tesseract stdin stdout -l eng 2> /dev/null)
text="${text%"${text##*[![:space:]]}"}" # trim trailing whitespace/newlines

if [[ -z "$text" ]]; then
  notify-send -a "$app" -u low "OCR" "No text found (or selection cancelled)"
  exit 1
fi

wl-copy -- "$text"
notify-send -a "$app" "Text copied" "$(head -c 200 <<< "$text")"
