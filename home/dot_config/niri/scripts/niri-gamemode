#!/usr/bin/env bash
# niri equivalent of hypr-gamemode (see hypr/scripts/executable_hypr-gamemode):
# strips gaps/opacity/shadow/rounding/animations for a distraction-free
# "gamemode" look.
#
# niri's window-rule has no per-workspace match criterion (only app-id,
# title, is-focused, etc -- see
# https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules), so the
# border/shadow/rounding/opacity part is scoped to the current workspace by
# snapshotting its windows right now and writing a window-rule that matches
# them by app-id+title into gamemode.kdl (included from config.kdl). Windows
# opened on this workspace *after* toggling on won't pick up the effect
# until you toggle gamemode again.
#
# gaps and animations are global settings in niri -- there's no way to scope
# those to one workspace -- so, like hypr-gamemode, they still apply
# compositor-wide.
#
# niri watches config.kdl (and its includes) and hot-reloads on save;
# load-config-file is called anyway for immediacy.

set -euo pipefail

config="$HOME/.config/niri/config.kdl"
rules="$HOME/.config/niri/gamemode.kdl"

current=$(grep -m1 -oP '^\s*gaps \K\d+' "$config")

if [[ "$current" == "0" ]]; then
  # --- currently on: turn off ---
  sed -i -E "s/^(\s*gaps )[0-9]+/\116/" "$config"
  sed -i '/off \/\/ gamemode$/d' "$config"
  printf '// gamemode off\n' >"$rules"
  niri msg action load-config-file
  notify-send 'Game mode disabled'
  exit
fi

# --- currently off: turn on ---
sed -i -E "s/^(\s*gaps )[0-9]+/\10/" "$config"
if ! grep -q 'off // gamemode$' "$config"; then
  sed -i '/^animations {/a\    off // gamemode' "$config"
fi

python3 - "$rules" <<'PY'
import json
import re
import subprocess
import sys


def kdl_str(s: str) -> str:
    """Escape a regex pattern for embedding in a double-quoted KDL string."""
    return re.escape(s).replace("\\", "\\\\").replace('"', '\\"')


def niri_json(*args):
    out = subprocess.run(
        ["niri", "msg", "--json", *args], capture_output=True, check=True, text=True
    )
    return json.loads(out.stdout)


rules_path = sys.argv[1]
workspaces = niri_json("workspaces")
windows = niri_json("windows")

focused = next((w["id"] for w in workspaces if w.get("is_focused")), None)
targets = [w for w in windows if focused is not None and w.get("workspace_id") == focused]

with open(rules_path, "w") as f:
    f.write("// Generated by scripts/niri-gamemode -- rewritten on every toggle, do not edit\n")
    if not targets:
        f.write("// (no windows on the current workspace)\n")
        sys.exit()
    f.write("window-rule {\n")
    for w in targets:
        app_id = kdl_str(w.get("app_id") or "")
        title = kdl_str(w.get("title") or "")
        f.write(f'    match app-id="^{app_id}$" title="^{title}$"\n')
    f.write("    border { width 1; }\n")
    f.write("    shadow { off; }\n")
    f.write("    geometry-corner-radius 0\n")
    f.write("    clip-to-geometry true\n")
    f.write("    opacity 1.0\n")
    f.write("}\n")
PY

niri msg action load-config-file
notify-send 'Game mode enabled'
