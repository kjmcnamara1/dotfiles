# vim: ft=config

# Theme
theme = Onenord

# Font
font-size = 14
adjust-cell-height = 20%
bold-color = bright

# Window
window-decoration = false
window-save-state = always
confirm-close-surface = false

# Terminal
mouse-hide-while-typing = true

# Remove default bindings
keybind = clear

keybind = all:ctrl+shift+f5=reload_config
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+shift+i=inspector:toggle
keybind = ctrl+0=reset_font_size

# Clipboard
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard

# Tabs
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_tab:this
# keybind = ctrl+tab=next_tab
keybind = ctrl+page_down=next_tab
keybind = ctrl+page_up=previous_tab

# Scrolling
keybind = ctrl+shift+page_down=jump_to_prompt:1
keybind = ctrl+shift+page_up=jump_to_prompt:-1
keybind = page_down=scroll_page_down
keybind = page_up=scroll_page_up
keybind = ctrl+end=scroll_to_bottom
keybind = ctrl+home=scroll_to_top

