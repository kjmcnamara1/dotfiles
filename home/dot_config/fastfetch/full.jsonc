{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto", // Logo type: auto, builtin, small, file, etc.
    "source": "arch", // Built-in logo name or file path
    "color": {
      "1": "light_blue",
      "2": "blue",
    },
  },
  "display": {
    "disableLinewrap": true,
    // "separator": "  »  ",
    "separator": " ",
    // "stat": true,
    "color": {
      "keys": "blue", // Key color
      "title": "red", // Title color
      // "output": "yellow", // Output color
      // "separator": "black",
    },
    "key": {
      "width": 4, // Aligns keys to this width
      "type": "icon", // string, icon, both, or none
      // "paddingLeft": 4,
    },
    "size": {
      "binaryPrefix": "si",
    },
    "bar": {
      "width": 20, // Width of percentage bars
      "border": {
        // "left": "[ ",
        // "left": "",
        // "leftElapsed": "",
        // "right": "",
        // "rightElapsed": "",
        "left": "",
        "right": "",
        "leftElapsed": "",
        "rightElapsed": "",
      },
      "char": {
        // "elapsed": "■",
        // "total": "-",
        // "elapsed": "",
        // "total": "",
        "elapsed": "─",
        "total": "─",
      },
      "color": {
        "elapsed": "auto",
        "total": "light_black",
      },
    },
    "percent": {
      "type": ["num", "bar"],
      "color": {
        "green": "green",
        "yellow": "yellow",
        "red": "red",
      },
    },
    "duration": {
      "abbreviation": true,
    },
    "fraction": {
      "trailingZeros": "never",
    },
    "constants": [],
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "colors",
      // "paddingLeft": 2,
      "symbol": "circle",
      "keyIcon": "",
    },
    "break",

    // System
    "os",
    "kernel",
    "host",
    "users",
    "initsystem",
    "packages",
    "processes",
    "locale",
    "break",

    // Hardware
    "chassis",
    "board",
    "bios",
    "bluetoothradio",
    "cpu",
    "gpu",
    "physicaldisk",
    "physicalmemory",
    "tpm",
    "bootmgr",
    "vulkan",
    "opencl",
    "opengl",
    "break",

    // Laptop
    "wifi",
    "bluetooth",
    "camera",

    "battery",
    "poweradapter",
    "brightness",
    "break",

    // Misc
    // "datetime",
    // "weather",
    "version",
    "break",

    // Display
    "display",
    // "monitor",
    "break",

    // Storage
    "btrfs",
    "diskio",
    "zpool",
    "break",

    // Status
    "uptime",
    {
      "type": "command",
      "key": "  󱦟 OS Age ",
      "keyIcon": "󱦟",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    "cpuusage",
    "memory",
    "disk",
    "swap",
    // "cpucache",
    // "loadavg",
    "break",

    // Network
    "publicip",
    "localip",
    "dns",
    "netio",
    "break",

    // Input
    "keyboard",
    "mouse",
    "gamepad",
    "break",

    // Media
    "media",
    "player",
    "sound",
    "break",

    // Environment
    "de",
    "lm",
    "wm",
    "wmtheme",
    "wallpaper",
    "editor",
    "shell",
    "theme",
    "font",
    "icons",
    "cursor",
    "terminal",
    "terminalfont",
    "terminalsize",
    "terminaltheme",
  ],
}
