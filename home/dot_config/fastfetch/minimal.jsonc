{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small", // Logo type: auto, builtin, small, file, etc.
    "source": "arch", // Built-in logo name or file path
    "color": {
      "1": "light_blue",
      "2": "light_blue",
    },
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "blue",
      "title": "red",
      "output": "magenta",
    },
    "key": {
      "width": 4,
      "type": "icon",
      // "paddingLeft": 2,
    },
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "",
      "outputColor": "light_black",
    },

    "uptime",
    "publicip",
    // "break",

    "terminal",
    "shell",
    "wm",
    {
      "type": "colors",
      "paddingLeft": 3,
      "symbol": "circle",
    },
  ],
}
