// Zed keymap -- personal overrides ONLY.
//
// Zed's built-in keymaps (base + vim/helix) are always loaded underneath this
// file, and anything here wins over them in the same context. Do NOT paste
// copies of the default keymap in here: stale copies shadow vim/helix bindings
// (e.g. Editor "escape" -> editor::Cancel kept helix insert mode from exiting).
//
// See defaults with `zed: open default keymap`; docs: https://zed.dev/docs/key-bindings
[
  {
    "bindings": {
      "shift-pagedown": "menu::SelectFirst",
      "ctrl-shift-o": "workspace::Open",
      "ctrl-+": "zed::IncreaseBufferFontSize",
      "ctrl--": "zed::DecreaseBufferFontSize",
      "ctrl-0": "zed::ResetBufferFontSize",
      "ctrl-,": "zed::OpenSettings",
      "f11": "zed::ToggleFullScreen",
      "ctrl-alt-i": "zed::DebugElements",
      "ctrl-\"": "editor::ToggleInlayHints",
      "shift-escape": null
    }
  },

  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-r": "workspace::Reload",
      "alt-ctrl-shift-o": ["projects::OpenRecent", { "create_new_window": true}],
      "ctrl-alt-s": "workspace::SaveWithoutFormat",
      "ctrl-`": "terminal_panel::ToggleFocus",
      "ctrl-alt-y": "workspace::CloseAllDocks",
      "ctrl-;": "zed::OpenKeymap",
      "ctrl-?": "agent::ToggleFocus",
      "ctrl-alt-shift-s": "workspace::SaveAll",
      "alt-backspace": "pane::CloseActiveItem"
    }
  },

  {
    "context": "Pane",
    "bindings": {
      "ctrl-shift-t": "pane::ReopenClosedItem",
      "alt-h": "pane::ActivatePreviousItem",
      "alt-l": "pane::ActivateNextItem",
      "alt-ctrl-h": "pane::SwapItemLeft",
      "alt-ctrl-l": "pane::SwapItemRight"
    }
  },

  {
    "context": "ProjectPanel || CollabPanel || OutlinePanel || ChatPanel || VimControl || EmptyPane || SharedScreen || MarkdownPreview || KeyContextView || Dock || ThemePreview",
    "bindings": {
      "ctrl-w": null,
      "ctrl-shift-h": "workspace::SwapPaneLeft",
      "ctrl-shift-l": "workspace::SwapPaneRight",
      "ctrl-shift-k": "workspace::SwapPaneUp",
      "ctrl-shift-j": "workspace::SwapPaneDown",
      "ctrl-w w": "workspace::ActivateNextPane",
      "ctrl-w ctrl-w": "workspace::ActivateNextPane",
      "ctrl-w p": "workspace::ActivatePreviousPane",
      "ctrl-w ctrl-p": "workspace::ActivatePreviousPane",
      "ctrl-w v": "pane::SplitVertical",
      "ctrl-w ctrl-v": "pane::SplitVertical",
      "ctrl-w s": "pane::SplitHorizontal",
      "ctrl-w ctrl-s": "pane::SplitHorizontal",
      "ctrl-w c": "pane::CloseAllItems",
      "ctrl-w ctrl-c": "pane::CloseAllItems",
      "ctrl-w q": "pane::CloseAllItems",
      "ctrl-w ctrl-q": "pane::CloseAllItems",
      "ctrl-w o": "workspace::CloseInactiveTabsAndPanes",
      "ctrl-w ctrl-o": "workspace::CloseInactiveTabsAndPanes",
      "ctrl-w n": "workspace::NewFileSplitHorizontal",
      "ctrl-w ctrl-n": "workspace::NewFileSplitHorizontal"
    }
  },

  {
    "context": "Editor",
    "bindings": {
      "alt-q": "editor::Rewrap",
      "ctrl-delete": "editor::DeleteToNextWordEnd",
      "home": "editor::MoveToBeginningOfLine",
      "end": "editor::MoveToEndOfLine",
      "shift-home": ["editor::SelectToBeginningOfLine", { "stop_at_soft_wraps": true}],
      "ctrl-:": "editor::ToggleLineNumbers",
      "alt-g b": "git::Blame",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      "alt-*": [
        "editor::SelectNext",
        {
          "replace_newest": false
        }
      ],
      "alt-#": [
        "editor::SelectPrevious",
        {
          "replace_newest": false
        }
      ],
      "alt-u": "editor::UndoSelection",
      "alt-shift-u": "editor::RedoSelection",
      "ctrl-/": "vim::ToggleComments",
      "f8": "editor::GoToDiagnostic",
      "shift-f8": "editor::GoToPreviousDiagnostic",
      "ctrl-shift-\\": "editor::MoveToEnclosingBracket",
      "ctrl-shift-[": "editor::Fold",
      "ctrl-shift-]": "editor::UnfoldLines",
      "alt-ctrl-r": "editor::RevealInFileManager",
      "ctrl-k v": "markdown::OpenPreviewToTheSide",
      "ctrl-shift-v": "markdown::OpenPreview"
    }
  },

  {
    "context": "Editor && mode == full",
    "bindings": {
      "alt-z": "editor::ToggleSoftWrap",
      "ctrl->": "agent::AddSelectionToThread",
      "alt-enter": "editor::OpenExcerpts",
      "shift-enter": "editor::ExpandExcerpts",
      "ctrl-k enter": "editor::OpenExcerptsSplit",
      "ctrl-enter": "assistant::InlineAssist"
    }
  },

  {
    "context": "Editor && mode == full && edit_prediction",
    "bindings": {
      "ctrl-right": "editor::AcceptNextWordEditPrediction"
    }
  },

  {
    "context": "Editor && edit_prediction && !showing_completions",
    "bindings": {
      "tab": "editor::AcceptEditPrediction"
    }
  },

  {
    "context": "ProposedChangesEditor",
    "bindings": {
      "ctrl-shift-y": "editor::ApplyDiffHunk",
      "ctrl-alt-a": "editor::ApplyAllDiffHunks"
    }
  },

  {
    "context": "Editor && jupyter && !ContextEditor",
    "bindings": {
      "ctrl-shift-enter": "repl::Run",
      "ctrl-alt-enter": "repl::RunInPlace"
    }
  },

  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "alt-ctrl-shift-c": "workspace::CopyRelativePath",
      "ctrl-k enter": "editor::OpenExcerptsSplit"
    }
  },

  {
    "context": "ProjectPanel",
    "bindings": {
      "backspace": ["project_panel::Trash", { "skip_prompt": true}],
      "delete": ["project_panel::Trash", { "skip_prompt": true}],
      "alt-ctrl-shift-c": "workspace::CopyRelativePath",
      "ctrl-shift-enter": "workspace::OpenWithSystem",
      "alt-shift-f": "project_panel::NewSearchInDirectory"
    }
  },

  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "a": "project_panel::NewFile",
      "escape": "project_panel::ToggleFocus",
      "d": "project_panel::Trash",
      "r": "project_panel::Rename",
      "x": "project_panel::Cut",
      "y": "project_panel::Copy",
      "p": "project_panel::Paste",
      "g x": "project_panel::RevealInFileManager",
      "g f": "workspace::OpenWithSystem",
      "_": "project_panel::CollapseAllEntries"
    }
  },

  {
    "context": "TabSwitcher",
    "bindings": {
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious"
    }
  },

  {
    "context": "EmptyPane || SharedScreen || MarkdownPreview || KeyContextView || ThemePreview",
    "bindings": {
      ":": "command_palette::Toggle",
      "space u i": "dev::OpenSyntaxTreeView",
      "space u I": "dev::OpenKeyContextView",
      "space t": "theme_selector::Toggle",
      "space '": "pane::AlternateFile",
      "space .": "file_finder::Toggle",
      "space b p": "pane::TogglePinTab",
      "space ,": "tab_switcher::Toggle",
      "g /": "pane::DeploySearch"
    }
  },

  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-shift-enter": "repl::Run",
      "space j": "vim::JoinLines",
      "space u i": "dev::OpenSyntaxTreeView",
      "space u shift-i": "dev::OpenKeyContextView",
      "space l": "language_selector::Toggle",
      "space t": "theme_selector::Toggle",
      "space '": "pane::AlternateFile",
      "space .": "file_finder::Toggle",
      "space ,": "tab_switcher::Toggle",
      "space ?": "zed::OpenKeymap"
    }
  },

  // Agent message box: ctrl-enter always sends (also beats the generic
  // "Editor && mode == full" ctrl-enter -> InlineAssist above). In insert mode
  // enter is a plain newline; in vim/helix normal mode enter sends and
  // ctrl-d / ctrl-u scroll the thread a page down / up.
  {
    "context": "AcpThread > Editor",
    "bindings": {
      "ctrl-enter": "agent::Chat"
    }
  },
  {
    "context": "AcpThread > Editor && vim_mode == insert",
    "bindings": {
      "enter": "editor::Newline"
    }
  },
  {
    "context": "AcpThread > Editor && (vim_mode == normal || vim_mode == helix_normal)",
    "bindings": {
      "enter": "agent::Chat",
      "ctrl-d": "agent::ScrollOutputPageDown",
      "ctrl-u": "agent::ScrollOutputPageUp"
    }
  },

  // Git commit message: escape in normal mode refocuses the changes list,
  // keeping its selection. (Insert-mode escape still just drops to normal mode.)
  {
    "context": "CommitEditor > Editor && (vim_mode == normal || vim_mode == helix_normal)",
    "bindings": {
      "escape": "git_panel::FocusChanges"
    }
  },

  // Plain space does nothing in vim normal mode (was vim::WrappingRight), so it
  // is only the leader for "space ..." chords and never times out.
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space": null
    }
  },

  // Helix: { / } act exactly like [p / ]p (previous / next paragraph).
  // alt-) / alt-( rotate selection contents; & aligns selections.
  // shift-j / shift-k duplicate below / above (moved off shift-c / alt-shift-c);
  // join lines moves to alt-shift-j. s is vim-sneak (replaces select-regex).
  // ctrl-alt-s saves position to the jumplist (ctrl-s is now plain save).
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "bindings": {
      "{": ["workspace::SendKeystrokes", "[ p"],
      "}": ["workspace::SendKeystrokes", "] p"],
      "alt-)": "editor::RotateSelectionsForward",
      "alt-(": "editor::RotateSelectionsBackward",
      "&": "editor::AlignSelections",
      "shift-j": "vim::HelixDuplicateBelow",
      "shift-k": "vim::HelixDuplicateAbove",
      "alt-shift-j": "vim::JoinLines",
      "shift-c": null,
      "alt-shift-c": null,
      "s": ["vim::PushSneak", {}],
      "ctrl-alt-s": "editor::SaveLocation"
    }
  },

  // Git file list: space toggles staged immediately. Drop vim.json's
  // "!Editor && !Terminal" space chords, which make space wait for a 2nd key.
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector && !GitRepositorySelector",
    "bindings": {
      "space": "git::ToggleStaged",
      "space f": null,
      "space /": null,
      "space shift-s": null,
      "space w h": null,
      "space w j": null,
      "space w k": null,
      "space w l": null,
      "space w q": null
    }
  },

  // Keymap editor table: delete removes the selected binding. (The search box
  // is a deeper Editor context, so delete still deletes text there.)
  {
    "context": "KeymapEditor",
    "bindings": {
      "delete": "keymap_editor::DeleteBinding"
    }
  },
  // ...and i or / jump back to the filter box. `!Editor` is false anywhere
  // under an Editor, so typing i or / in the filter box still types.
  {
    "context": "KeymapEditor && !Editor",
    "bindings": {
      "i": "search::FocusSearch",
      "/": "search::FocusSearch"
    }
  },

  // Normal mode in a buffer: escape only clears search highlights (like :noh);
  // it no longer collapses selections / multicursors (that was editor::Cancel).
  {
    "context": "Editor && mode == full && (vim_mode == normal || vim_mode == helix_normal) && !menu",
    "bindings": {
      "escape": "buffer_search::Dismiss"
    }
  },

  // Git panel: alt-h / alt-l switch between the Changes and History tabs.
  {
    "context": "GitPanel",
    "bindings": {
      "alt-h": "git_panel::ActivateChangesTab",
      "alt-l": "git_panel::ActivateHistoryTab"
    }
  },

  // ctrl-h/j/k/l move pane focus, alt-m toggles zoom, ctrl-s saves and
  // ctrl-shift-s saves without formatting -- everywhere, in
  // every vim/helix mode. Keep this
  // block LAST: deeper contexts (Editor, Terminal, panels) beat Workspace, so
  // each is listed explicitly, and later blocks win ties at the same depth.
  // Shadows terminal ctrl-l (clear) / ctrl-k (kill line) and vim insert ctrl-h/j/k.
  {
    "context": "Workspace || Editor || Terminal || Dock || ProjectPanel || OutlinePanel || GitPanel || CollabPanel || AgentPanel || AcpThread || EmptyPane || SharedScreen || MarkdownPreview || KeyContextView || ThemePreview || DebugPanel",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "alt-m": "workspace::ToggleZoom",
      "ctrl-s": "workspace::Save",
      "ctrl-shift-s": "workspace::SaveWithoutFormat",
      "alt-shift-h": "pane::SwapItemLeft",
      "alt-shift-l": "pane::SwapItemRight",
      "ctrl-'": "terminal_panel::Toggle",
      "ctrl-backspace": "pane::CloseAllItems"
    }
  },

  // ctrl-backspace inside a dock (project/git/outline/agent/terminal panels)
  // NB: in contexts `>` binds looser than `||`/`&&`, so parenthesize when mixing.
  // closes the dock instead. Must come after the block above to win its ties.
  {
    "context": "Dock || Dock > (Editor || Terminal || ProjectPanel || OutlinePanel || GitPanel || CollabPanel || AgentPanel || AcpThread || DebugPanel)",
    "bindings": {
      "ctrl-backspace": "workspace::CloseActiveDock"
    }
  },

  // ...except when typing: ctrl-backspace deletes the previous word in insert
  // mode, any single-line input (search/filter boxes), and every terminal. Must stay after both ctrl-backspace blocks above.
  {
    "context": "(Editor && vim_mode == insert) || (Editor && mode == single_line) || (KeymapEditor > Editor) || (KeybindEditorModal > Editor)",
    "bindings": {
      "ctrl-backspace": "editor::DeleteToPreviousWordStart"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-backspace": ["terminal::SendKeystroke", "ctrl-w"]
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "*": "buffer_search::UseSelectionForFind"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-n": "workspace::NewFile"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-n": "workspace::NewFile"
    }
  },
  {
    "context": "Welcome",
    "bindings": {
      "ctrl-alt-n": "workspace::NewFile"
    }
  },
  {
    "context": "Welcome",
    "unbind": {
      "ctrl-n": "workspace::NewFile"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "shift-h": "pane::ActivatePreviousItem"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "shift-l": "pane::ActivateNextItem"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "bindings": {
      "shift-s": "vim::HelixSelectRegex"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "s": "vim::HelixSelectRegex"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "z c": "editor::ScrollCursorCenter"
    }
  },
  {
    "context": "OutlinePanel && not_editing",
    "unbind": {
      "z c": "outline_panel::ScrollCursorCenter"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "unbind": {
      "z c": "project_panel::ScrollCursorCenter"
    }
  }
]
